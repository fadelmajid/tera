# Copy to .env for local development. .env is gitignored.

# --- goose ---------------------------------------------------------------
# `make migrate-*` passes these explicitly, so this file is only needed when
# invoking the goose CLI directly (goose reads .env by default).
GOOSE_DRIVER=sqlite3
GOOSE_DBSTRING=./tera.db
GOOSE_MIGRATION_DIR=internal/store/migrations

# --- tera ----------------------------------------------------------------
# Bind 0.0.0.0, never localhost: clients are browsers on the shop LAN, not
# processes on this machine (R8.4, ARCHITECTURE §1).
TERA_ADDR=0.0.0.0:8080
TERA_DB_PATH=./tera.db

# Backup target. A backup on the same disk is not a backup (R14.2).
TERA_BACKUP_DIR=/Volumes/BACKUP/tera
