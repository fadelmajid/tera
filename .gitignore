# go
/bin/
/tera
*.test
*.out

# sqlite — the database is the business's data, never the repo's
*.db
*.db-wal
*.db-shm

# backups (R14) — local target, not source
/backups/

# node / vite
node_modules/
# The build output is embedded into the binary, so it is generated, not source.
# .gitkeep stays: //go:embed fails at compile time on a pattern matching nothing,
# so a fresh clone needs the directory to exist.
web/dist/*
!web/dist/.gitkeep
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# editors / os
.idea/
.vscode/
*.swp
.DS_Store
